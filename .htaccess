<IfModule mod_rewrite.c>
    Options -Indexes

    RewriteEngine On

    # Do not expose Laravel source, configuration, dependencies, or runtime files.
    RewriteRule ^(?:\.env(?:\..*)?|app|bootstrap|config|database|resources|routes|storage|tests|vendor)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:artisan|composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit\.xml|vite\.config\.js)$ - [F,L,NC]

    # cPanel serves this directory as the web root. Internally forward each
    # request to Laravel's real public directory, whose own .htaccess routes
    # dynamic requests to public/index.php.
    RewriteCond %{REQUEST_URI} !^/public(?:/|$)
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
